# ══════════════════════════════════════════════════════════
# 백엔드 환경변수 — Railway 배포 기준
# ══════════════════════════════════════════════════════════

# ── 기본 ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./soccer_analyzer.db
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── 서버 업로드 (R2를 쓰지 않을 때) ───────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=4096

# ── RunPod GPU 영상 분석 워커 (backend/Dockerfile.worker) ──
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_endpoint_id_here
# RUNPOD_MAX_WAIT_SEC=5400

# ── Cloudflare R2 (브라우저 → R2 직접 업로드, RunPod가 영상을 내려받는 곳) ──
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=soccer-videos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── 서버에서 직접 영상 분석할 때 (requirements-worker.txt 설치 시) ──
# YOLO_MODEL=yolov8m.pt
# YOLO_IMGSZ=1280
# YOLO_DEVICE=cuda:0
